+          <Button
+            variant="solid"
+            disabled={priceSaving || Object.keys(inlinePrices).length === 0}
+            onClick={handleSaveAllChangedPrices}
+          >
+            {priceSaving ? 'Saving…' : `Save All Changed (${Object.keys(inlinePrices).length})`}
+          </Button>
+        </Toolbar>
+
+        {priceError && (
+          <Alert tone="danger" title="Price Error">
+            {priceError}
+          </Alert>
