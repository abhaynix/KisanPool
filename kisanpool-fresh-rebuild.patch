+              .map((m) => renderMarketCard(m))}
+
+            {/* Footnote */}
+            <View style={styles.footnoteBox}>
+              <Txt variant="bodyMd" style={{ color: colors.onSurfaceVariant, fontSize: 12 }}>
+                * Estimated loss, guaranteed shelf life nahi.
+              </Txt>
+            </View>
+          </>
