+-const now = new Date('2026-10-24T12:00:00.000Z');
+-const liveObservation = {
+-  sourceMinPrice: 1000,
+-  sourceModalPrice: 1500,
+-  sourceMaxPrice: 2000,
+-  sourcePriceUnit: 'INR_PER_QUINTAL',
+-  sourceType: 'OFFICIAL' as const,
+-  sourceName: 'Test market source',
