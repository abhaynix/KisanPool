+-export async function recordFreshDeliveryOutcome(
+-  farmerId: string,
+-  input: {
+-    requestId: string;
+-    actualPickupAt: Date;
+-    actualDeliveredAt: Date;
+-    actualSoldPriceINRPerKg?: number;
+-    acceptedKg: number;
