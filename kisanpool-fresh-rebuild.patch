+-  }, { now });
+-  const simulated = normalizeMarketPrice({
+-    ...liveObservation,
+-    sourceType: 'SIMULATED',
+-    observedAt: null,
+-    fetchedAt: null,
+-  }, { now });
+-  assert.equal(stale.dataStatus, 'STALE');
+-  assert.equal(expired.dataStatus, 'EXPIRED');
