+            </div>
+          </Card>
+        ) : historyLoading ? (
+          <SkeletonTable />
+        ) : historyItems.length === 0 ? (
+          <Empty message={`No recorded price history for ${selectedHistory.marketName} (${selectedHistory.crop}).`} />
+        ) : (
+          <div className="card table-wrap">
+            <Table>
+              <thead>
+                <tr>
+                  <th>Observed At</th>
+                  <th>Price</th>
+                  <th>Unit</th>
+                  <th>₹ / kg equivalent</th>
+                  <th>Source</th>
+                  <th>Age (Hours)</th>
+                  <th>Freshness</th>
+                  <th>Recorded By</th>
+                </tr>
+              </thead>
+              <tbody>
+                {historyItems.map((item) => {
+                  const perKg =
+                    item.unit === 'kg'
+                      ? item.price
+                      : item.unit === 'quintal'
+                      ? item.price / 100
+                      : item.price / 1000;
+                  return (
+                    <tr key={item._id}>
+                      <td>{when(item.observedAt)}</td>
+                      <td>
+                        <strong>₹{item.price}</strong>
+                      </td>
+                      <td>{item.unit}</td>
+                      <td>₹{perKg.toFixed(2)}/kg</td>
+                      <td>
+                        <Chip tone="default">{item.sourceType}</Chip>
+                      </td>
+                      <td>{item.ageHours}h</td>
+                      <td>
+                        <Chip
+                          tone={
+                            item.freshness === 'fresh'
+                              ? 'success'
+                              : item.freshness === 'stale'
+                              ? 'warning'
+                              : 'danger'
+                          }
+                        >
+                          {(item.freshness || 'unknown').toUpperCase()}
+                        </Chip>
+                      </td>
+                      <td>
+                        <code>{item.createdBy}</code>
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </Table>
+          </div>
+        )}
+      </Section>
+    </div>
+  );
+}
