+
+const freshPriceSchema = new Schema(
+  {
+    marketId: {
+      type: Schema.Types.ObjectId,
+      ref: 'FreshMarket',
+      required: [true, 'Market ID zaroori hai'],
+      index: true,
+    },
+    crop: {
+      type: String,
+      enum: {
+        values: ACCEPTED_CROPS,
