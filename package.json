{
  "name": "kisanpool",
  "private": true,
  "version": "0.1.0",
  "description": "KisanPool — shared produce transport for Indian farmers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @kisanpool/server",
    "dev:mobile": "npm --prefix apps/mobile run start -- --clear",
    "build:shared": "npm run build --workspace @kisanpool/shared",
    "seed": "npm run seed --workspace @kisanpool/server --",
    "seed:fresh": "npm run seed:fresh --workspace @kisanpool/server",
    "seed:fresh-markets": "npm run seed:fresh-markets --workspace @kisanpool/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "bash tests/run-all.sh",
    "dev": "npm run dev:server",
    "dev:admin": "npm run dev --workspace @kisanpool/admin",
    "killport": "./bin/killport"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "expo-font": "58.0.10"
  }
}
